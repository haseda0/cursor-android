    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "@prisma/client": "^5.4.0",
    "redis": "^4.6.11",
    "axios": "^1.6.0",
    "ws": "^8.14.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.6",
    "stripe": "^13.8.0",
    "nodemailer": "^6.9.6",
    "zod": "^3.22.4",
