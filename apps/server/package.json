{
  "name": "cursor-server",
  "version": "1.0.0",
  "description": "AI Code Editor Backend API",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
