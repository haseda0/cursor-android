NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# OpenAI - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk_test_your_api_key_here

# JWT Secret - Change this in production!
JWT_SECRET=cursor-super-secret-key-change-in-production

# Client URL - Update based on deployment
CLIENT_URL=http://localhost:3000

# Database (optional - for future)
DATABASE_URL=postgresql://user:password@localhost/cursor
REDIS_URL=redis://localhost:6379
